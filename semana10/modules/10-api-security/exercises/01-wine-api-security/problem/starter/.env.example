# Variables de entorno de la Wine Quality API.
#
# Generación de claves seguras para entornos reales:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# `.env` está en .gitignore: nunca lo subas al repositorio.

# Predictor: `ready` o `unavailable` (simula un modelo no cargado).
WINE_API_MODE=ready

# TODO S10.1c: documenta aquí el resto de variables de `Settings`, con un
# comentario por variable y valores de EJEMPLO, nunca reales:
# - WINE_API_CLIENTS: dos clientes en JSON, `front` (solo `predict`) y `ops`
#   (`predict` y `admin`), cada uno con su clave y su `rate_limit_per_minute`.
#   Las claves de ejemplo empiezan por `cambia-` para que nadie las confunda
#   con claves reales.
# - WINE_API_CORS_ORIGINS: lista JSON con el origen del front de Streamlit.
# - WINE_API_DOCS_ENABLED: `true` o `false`.
# Investiga cómo lee pydantic-settings un `dict` o una `list` desde una
# variable de entorno y por qué conviene envolver el JSON en comillas simples
# dentro de `.env`.
# Comprobación: tests/test_s10_1_settings.py::test_env_example_documents_every_setting_with_placeholders

# Clientes en JSON: nombre -> clave, scopes (`predict`, `admin`) y cuota/minuto.
# Sin clientes, todo endpoint protegido responde 401 (fail closed).
WINE_API_CLIENTS='{"front": {"key": "cambia-esta-clave-front", "scopes": ["predict"], "rate_limit_per_minute": 60}, "ops": {"key": "cambia-esta-clave-ops", "scopes": ["predict", "admin"], "rate_limit_per_minute": 30}}'

# Orígenes de navegador que pueden leer la API (JSON). Nunca "*".
WINE_API_CORS_ORIGINS='["http://localhost:8501"]'

# `false` desactiva /docs, /redoc y /openapi.json (por ejemplo, en producción).
WINE_API_DOCS_ENABLED=true
